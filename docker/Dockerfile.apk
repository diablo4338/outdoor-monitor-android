# syntax=docker/dockerfile:1.7
FROM ghcr.io/cirruslabs/android-sdk:35 AS build

WORKDIR /workspace
COPY . ./

ARG VERSION_NAME
ARG VERSION_CODE
ARG RELEASE_API_BASE_URL
ARG GOOGLE_WEB_CLIENT_ID
ARG POLL_INTERVAL_SECONDS=10
ARG GIT_COMMIT
ARG PUBLISHED_AT

RUN --mount=type=secret,id=release_keystore \
    --mount=type=secret,id=signing_store_password \
    --mount=type=secret,id=signing_key_password \
    --mount=type=cache,target=/root/.gradle \
    set -eu; \
    case "$VERSION_NAME" in *[!0-9A-Za-z.+-]*) exit 2;; esac; \
    case "$VERSION_CODE" in ''|*[!0-9]*) exit 2;; esac; \
    test -n "$RELEASE_API_BASE_URL"; \
    test -n "$GOOGLE_WEB_CLIENT_ID"; \
    export VERSION_NAME VERSION_CODE RELEASE_API_BASE_URL GOOGLE_WEB_CLIENT_ID POLL_INTERVAL_SECONDS; \
    export DEBUG_API_BASE_URL="$RELEASE_API_BASE_URL"; \
    export SIGNING_STORE_FILE=/run/secrets/release_keystore; \
    export SIGNING_STORE_PASSWORD="$(cat /run/secrets/signing_store_password)"; \
    export SIGNING_KEY_ALIAS=release; \
    export SIGNING_KEY_PASSWORD="$(cat /run/secrets/signing_key_password)"; \
    sed -i 's/\r$//' gradlew; \
    chmod +x gradlew; \
    ./gradlew --no-daemon :app:assembleRelease; \
    apk_source="$(find app/build/outputs/apk/release -name '*.apk' -type f | head -n 1)"; \
    test -n "$apk_source"; \
    release_dir="/output/releases/$VERSION_CODE"; \
    filename="outdoor-monitor-$VERSION_NAME-$VERSION_CODE.apk"; \
    mkdir -p "$release_dir"; \
    cp "$apk_source" "$release_dir/$filename"; \
    sha256="$(sha256sum "$release_dir/$filename" | cut -d ' ' -f 1)"; \
    size="$(stat -c %s "$release_dir/$filename")"; \
    published_at="${PUBLISHED_AT:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"; \
    printf '{\n  "version_name": "%s",\n  "version_code": %s,\n  "filename": "%s",\n  "sha256": "%s",\n  "size": %s,\n  "published_at": "%s",\n  "git_commit": "%s"\n}\n' \
      "$VERSION_NAME" "$VERSION_CODE" "$filename" "$sha256" "$size" "$published_at" "$GIT_COMMIT" \
      > "$release_dir/manifest.json"; \
    cp "$release_dir/manifest.json" /output/releases/latest.json

FROM scratch AS artifact
COPY --from=build /output/ /
